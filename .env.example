BREVO_SMTP_KEY=your_brevo_smtp_key

# Optional: when missing or quota-limited, the system automatically falls back to free rules
GEMINI_API_KEY=your_google_gemini_api_key


# Optional translation providers. Keep these as GitHub Actions Secrets, never commit real keys.
GOOGLE_TRANSLATE_API_KEY=
MICROSOFT_TRANSLATOR_KEY=
MICROSOFT_TRANSLATOR_REGION=
MYMEMORY_EMAIL=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
